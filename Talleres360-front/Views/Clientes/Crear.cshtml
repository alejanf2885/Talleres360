@model Talleres360_front.Models.Clientes.ClienteFormModel
@{
    ViewData["Title"] = "Nuevo cliente";
}

<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="link-muted-360">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
        </a>
        <div>
            <h1 class="page-title">Nuevo cliente</h1>
            <p class="page-subtitle">Rellena los datos del cliente</p>
        </div>
    </div>
</div>

<div class="w-100" style="max-width:672px;">
    <div class="card">

        @if (!Html.ViewData.ModelState.IsValid && Html.ViewData.ModelState.ContainsKey(string.Empty))
        {
            <div class="mb-4 p-3 rounded-3 border" style="background:var(--c-red-soft);color:var(--c-red);border-color:rgba(12, 18, 30, 0.15);">
                @Html.ValidationSummary(true)
            </div>
        }

        <form asp-action="Crear" method="post" asp-antiforgery="true">

            <div class="row g-3">

                <div class="form-group col-12 col-md-6">
                    <label asp-for="Nombre" class="form-label">Nombre <span style="color:var(--c-red);">*</span></label>
                    <input asp-for="Nombre" class="form-input" placeholder="Nombre del cliente o empresa" autofocus />
                    <span asp-validation-for="Nombre" class="form-error"></span>
                </div>

                <div class="form-group col-12 col-md-6">
                    <label asp-for="Apellidos" class="form-label">Apellidos</label>
                    <input asp-for="Apellidos" class="form-input" placeholder="Apellidos (personas físicas)" />
                    <span asp-validation-for="Apellidos" class="form-error"></span>
                </div>

                <div class="form-group col-12 col-md-6">
                    <label asp-for="NifCif" class="form-label">NIF / CIF</label>
                    <input asp-for="NifCif" class="form-input" placeholder="12345678A" />
                    <span asp-validation-for="NifCif" class="form-error"></span>
                </div>

                <div class="form-group col-12 col-md-6">
                    <label class="form-label">Tipo de cliente</label>
                    <label class="d-flex align-items-center gap-2 mt-2" style="cursor:pointer;">
                        <input asp-for="EsEmpresa" type="checkbox" class="form-check-input" style="accent-color:var(--c-accent);border-color:var(--c-border);" />
                        <span class="small" style="color:var(--c-text-secondary);">Es empresa / autónomo</span>
                    </label>
                </div>

                <div class="form-group col-12 col-md-6">
                    <label asp-for="Telefono" class="form-label">Teléfono <span style="color:var(--c-red);">*</span></label>
                    <input asp-for="Telefono" type="tel" class="form-input" placeholder="612 345 678" />
                    <span asp-validation-for="Telefono" class="form-error"></span>
                </div>

                <div class="form-group col-12 col-md-6">
                    <label asp-for="Email" class="form-label">Correo electrónico <span style="color:var(--c-red);">*</span></label>
                    <input asp-for="Email" type="email" class="form-input" placeholder="cliente@ejemplo.com" />
                    <span asp-validation-for="Email" class="form-error"></span>
                </div>

                <div class="form-group col-12">
                    <label asp-for="Direccion" class="form-label">Dirección</label>
                    <input asp-for="Direccion" class="form-input" placeholder="Calle, número, piso…" />
                    <span asp-validation-for="Direccion" class="form-error"></span>
                </div>

                <div class="form-group col-12 col-md-6">
                    <label asp-for="CodigoPostal" class="form-label">Código postal</label>
                    <input asp-for="CodigoPostal" class="form-input" placeholder="28001" />
                    <span asp-validation-for="CodigoPostal" class="form-error"></span>
                </div>

                <div class="form-group col-12 col-md-6">
                    <label asp-for="Localidad" class="form-label">Localidad</label>
                    <input asp-for="Localidad" class="form-input" placeholder="Madrid" />
                    <span asp-validation-for="Localidad" class="form-error"></span>
                </div>

                <div class="form-group col-12 col-md-6">
                    <label asp-for="Provincia" class="form-label">Provincia</label>
                    <input asp-for="Provincia" class="form-input" placeholder="Madrid" />
                    <span asp-validation-for="Provincia" class="form-error"></span>
                </div>

                <div class="form-group col-12">
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input asp-for="AceptaComunicaciones" type="checkbox" class="form-check-input" style="accent-color:var(--c-accent);border-color:var(--c-border);" />
                        <span class="small" style="color:var(--c-text-secondary);">Acepta recibir comunicaciones comerciales (RGPD)</span>
                    </label>
                </div>

            </div>

            <div class="d-flex align-items-center justify-content-end gap-3 mt-4 pt-4 border-top" style="border-color:var(--c-border);">
                <a asp-action="Index" class="btn btn-secondary btn-md">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-md">Guardar cliente</button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
