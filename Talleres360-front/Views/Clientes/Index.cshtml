@model Talleres360.Dtos.PagedResponse<Talleres360.Models.Negocio.Cliente>
@{
    ViewData["Title"] = "Clientes";
    string? buscar = ViewData["Buscar"] as string;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Clientes</h1>
        <p class="page-subtitle">Gestión de clientes del taller</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary btn-md">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Nuevo cliente
    </a>
</div>

<div id="panel-overlay" class="panel-backdrop d-none" onclick="closePanel()"></div>
<div id="cliente-panel" class="panel panel-closed" style="width:clamp(320px,40vw,480px);">
    <div id="panel-content"></div>
</div>

<div class="table-card">

    <div class="table-toolbar">
        <div class="search-bar w-100 w-sm-auto flex-sm-grow-1">
            <span class="search-bar-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
            </span>
            <input id="search-input" type="search" class="search-input"
                   placeholder="Buscar por nombre, email, NIF…"
                   value="@buscar" autocomplete="off" />
        </div>
        <span class="small ms-auto d-none d-sm-inline" style="color:var(--c-text-muted);">
            @(ViewData["TotalCount"]) cliente@((int)(ViewData["TotalCount"] ?? 0) != 1 ? "s" : "")
        </span>
    </div>

    <div class="table-wrap">
        <table class="t360" id="clientes-table">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th class="d-none d-sm-table-cell">NIF / CIF</th>
                    <th class="d-none d-md-table-cell">Teléfono</th>
                    <th class="d-none d-lg-table-cell">Email</th>
                    <th class="d-none d-xl-table-cell">Alta</th>
                    <th style="width:32px;"></th>
                </tr>
            </thead>
            <tbody id="clientes-tbody">
                @await Html.PartialAsync("_TablaFilas", Model)
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination")

</div>

@section Scripts {
<script>
// ── Buscador con debounce ──────────────────────────────
let searchTimer;
document.getElementById('search-input').addEventListener('input', function () {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
        const q = this.value.trim();
        const url = q ? `?buscar=${encodeURIComponent(q)}&pageNumber=1` : '?pageNumber=1';
        window.location.href = url;
    }, 350);
});

// ── Panel lateral ──────────────────────────────────────
async function openPanel(id) {
    const panel   = document.getElementById('cliente-panel');
    const overlay = document.getElementById('panel-overlay');
    const content = document.getElementById('panel-content');

    content.innerHTML = '<div class="d-flex align-items-center justify-content-center" style="height:8rem;color:var(--c-text-muted);"><div class="spinner-border spinner-border-sm" role="status"></div></div>';
    panel.classList.remove('panel-closed');
    overlay.classList.remove('d-none');
    document.body.style.overflow = 'hidden';

    try {
        const res  = await fetch(`/Clientes/${id}/Panel`);
        const html = await res.text();
        content.innerHTML = html;
    } catch {
        content.innerHTML = '<p class="p-4 small" style="color:var(--c-red);">Error al cargar los datos.</p>';
    }
}

function closePanel() {
    document.getElementById('cliente-panel').classList.add('panel-closed');
    document.getElementById('panel-overlay').classList.add('d-none');
    document.body.style.overflow = '';
}

document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel(); });
</script>
}
