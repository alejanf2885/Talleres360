@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string currentAction     = ViewContext.RouteData.Values["action"]?.ToString()     ?? string.Empty;

    string Cls(string controller, string? action = null)
    {
        bool ctrl = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        bool act  = action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return ctrl && act ? "sidebar-link active" : "sidebar-link";
    }
}

<aside class="sidebar">

    <div class="sidebar-logo">
        <svg class="sidebar-logo-svg" width="32" height="32" viewBox="0 0 56 56" fill="none">
            <path d="M14 10 A24 24 0 1 0 42 10" stroke="oklch(0.68 0.18 245)" stroke-width="3" stroke-linecap="round" fill="none"/>
            <circle cx="14" cy="10" r="4" fill="oklch(0.68 0.18 245)"/>
            <circle cx="42" cy="10" r="4" fill="oklch(0.68 0.18 245)"/>
            <rect x="25.5" y="26" width="5" height="20" rx="2.5" fill="white"/>
            <rect x="20" y="25" width="16" height="4" rx="2" fill="white"/>
        </svg>
        <div>
            <div class="sidebar-logo-text">Talleres<span>360</span></div>
        </div>
    </div>

    <nav class="sidebar-nav">

        <a asp-controller="Home" asp-action="Index" class="@Cls("Home", "Index")">
