@{
    int pageNumber      = (int)(ViewData["PageNumber"]      ?? 1);
    int totalPages      = (int)(ViewData["TotalPages"]      ?? 1);
    int totalCount      = (int)(ViewData["TotalCount"]      ?? 0);
    bool hasPrev        = (bool)(ViewData["HasPreviousPage"] ?? false);
    bool hasNext        = (bool)(ViewData["HasNextPage"]     ?? false);
    string? buscar      = ViewData["Buscar"] as string;
    string? filtro      = ViewData["Filtro"] as string;

    string PageUrl(int page)
    {
        var qs = $"?pageNumber={page}&pageSize=15";
        if (!string.IsNullOrEmpty(buscar)) qs += $"&buscar={Uri.EscapeDataString(buscar)}";
        if (!string.IsNullOrEmpty(filtro)) qs += $"&filtro={Uri.EscapeDataString(filtro)}";
        return qs;
    }
}

@if (totalPages > 1 || totalCount > 0)
{
    <div class="flex items-center justify-between px-4 py-3 border-t border-[var(--c-border)] bg-[var(--c-surface)]">

        <span class="text-xs text-[var(--c-text-muted)]">
            @totalCount resultado@(totalCount != 1 ? "s" : "")
        </span>

        <div class="flex items-center gap-1">

            @if (hasPrev)
            {
                <a href="@PageUrl(pageNumber - 1)"
                   class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-sm text-[var(--c-text-secondary)] hover:bg-[var(--c-bg)] hover:text-[var(--c-text)] transition-colors">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                </a>
            }
            else
            {
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-sm text-[var(--c-text-muted)] opacity-40 cursor-not-allowed">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                </span>
            }

            @{
                int start = Math.Max(1, pageNumber - 2);
                int end   = Math.Min(totalPages, pageNumber + 2);
            }

            @if (start > 1)
            {
                <a href="@PageUrl(1)" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-sm text-[var(--c-text-secondary)] hover:bg-[var(--c-bg)] transition-colors">1</a>
                @if (start > 2) { <span class="text-[var(--c-text-muted)] text-sm px-1">…</span> }
            }

            @for (int p = start; p <= end; p++)
            {
                if (p == pageNumber)
                {
                    <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-sm font-semibold bg-accent text-white">@p</span>
                }
                else
                {
                    <a href="@PageUrl(p)" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-sm text-[var(--c-text-secondary)] hover:bg-[var(--c-bg)] transition-colors">@p</a>
                }
            }

            @if (end < totalPages)
            {
                @if (end < totalPages - 1) { <span class="text-[var(--c-text-muted)] text-sm px-1">…</span> }
                <a href="@PageUrl(totalPages)" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-sm text-[var(--c-text-secondary)] hover:bg-[var(--c-bg)] transition-colors">@totalPages</a>
            }

            @if (hasNext)
            {
                <a href="@PageUrl(pageNumber + 1)"
                   class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-sm text-[var(--c-text-secondary)] hover:bg-[var(--c-bg)] hover:text-[var(--c-text)] transition-colors">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </a>
            }
            else
            {
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-sm text-[var(--c-text-muted)] opacity-40 cursor-not-allowed">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </span>
            }

        </div>
    </div>
}
