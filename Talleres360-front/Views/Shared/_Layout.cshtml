<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — Talleres360" : "Talleres360")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<div id="sidebar-overlay" class="sidebar-overlay d-none" onclick="closeSidebar()"></div>

<div class="app-shell">

    @await Html.PartialAsync("_Sidebar")

    <div class="main-area">
        @await Html.PartialAsync("_Header")
        <main class="content-area page-enter">
            @RenderBody()
        </main>
    </div>

</div>

<div id="toast-container"></div>

<!-- Modal de confirmación global -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content confirm-modal-content">
            <div class="confirm-modal-body">
                <div id="confirmModalIcon" class="confirm-modal-icon confirm-modal-icon--danger">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                        <path d="M10 11v6"/><path d="M14 11v6"/>
                        <path d="M9 6V4h6v2"/>
                    </svg>
                </div>
                <div class="confirm-modal-text">
                    <p id="confirmModalTitle" class="confirm-modal-title"></p>
                    <p id="confirmModalMsg" class="confirm-modal-msg"></p>
                </div>
            </div>
            <div class="confirm-modal-footer">
                <button type="button" class="btn btn-secondary btn-md" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger btn-md" id="confirmModalOk">Confirmar</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@{
    string? toastSuccess = TempData["Success"] as string;
    string? toastError   = TempData["Error"]   as string;
    string? toastWarning = TempData["Warning"] as string;
}
@if (toastSuccess != null || toastError != null || toastWarning != null)
{
    <script>
        (function() {
            @if (toastSuccess != null) { <text>showToast(@Json.Serialize(toastSuccess), 'success');</text> }
            @if (toastError   != null) { <text>showToast(@Json.Serialize(toastError),   'error');</text>   }
            @if (toastWarning != null) { <text>showToast(@Json.Serialize(toastWarning), 'warning');</text> }
        })();
    </script>
}
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
