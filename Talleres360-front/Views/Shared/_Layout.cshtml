<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — Talleres360" : "Talleres360")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-toast-success="@TempData["Success"]"
      data-toast-error="@TempData["Error"]"
      data-toast-warning="@TempData["Warning"]">

<div class="app-shell">

    @await Html.PartialAsync("_Sidebar")

    <div class="main-area">
        @await Html.PartialAsync("_Header")
        <main class="content-area page-enter">
            @RenderBody()
        </main>
    </div>

</div>

<div id="toast-container"></div>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
