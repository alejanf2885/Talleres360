@model Talleres360.Dtos.PagedResponse<Talleres360.Dtos.Citas.CitaDto>
@using Talleres360.Enums
@{
    ViewData["Title"] = "Citas";
    string? estadoFiltro = ViewData["EstadoFiltro"] as string;

    string BadgeClass(CitaEstado e) => e switch {
        CitaEstado.PENDIENTE  => "badge-pendiente",
        CitaEstado.CONFIRMADA => "badge-activo",
        CitaEstado.EN_PROCESO => "badge-en-curso",
        CitaEstado.COMPLETADA => "badge-pagado",
        CitaEstado.CANCELADA  => "badge-inactivo",
        _                     => "badge-inactivo"
    };
    string BadgeLabel(CitaEstado e) => e switch {
        CitaEstado.PENDIENTE  => "Pendiente",
        CitaEstado.CONFIRMADA => "Confirmada",
        CitaEstado.EN_PROCESO => "En proceso",
        CitaEstado.COMPLETADA => "Completada",
        CitaEstado.CANCELADA  => "Cancelada",
        _                     => e.ToString()
    };
}

<div class="page-header">
    <div>
        <h1 class="page-title">Citas</h1>
        <p class="page-subtitle">Agenda de citas del taller</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary btn-md">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Nueva cita
    </a>
</div>

<div class="table-card">

    <div class="table-toolbar" style="flex-wrap:wrap;gap:8px;">
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-sm @(estadoFiltro == null ? "btn-primary" : "btn-secondary")">Todas</a>
            @foreach (CitaEstado e in Enum.GetValues<CitaEstado>())
            {
                string v = e.ToString();
                <a asp-action="Index" asp-route-estado="@v"
                   class="btn btn-sm @(estadoFiltro == v ? "btn-primary" : "btn-secondary")">
                    @BadgeLabel(e)
                </a>
            }
        </div>
        <span class="small ms-auto" style="color:var(--c-text-muted);white-space:nowrap;">
            @(ViewData["TotalCount"]) cita@((int)(ViewData["TotalCount"] ?? 0) != 1 ? "s" : "")
        </span>
    </div>

    <div class="table-wrap">
        <table class="t360">
            <thead>
                <tr>
                    <th>Cliente / Vehículo</th>
                    <th class="d-none d-sm-table-cell">Fecha</th>
                    <th class="d-none d-md-table-cell">Hora</th>
                    <th class="d-none d-md-table-cell">Descripción</th>
                    <th>Estado</th>
                    <th style="width:100px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Data.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5" style="color:var(--c-text-muted);">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="d-block mx-auto mb-3" style="opacity:0.4;">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                            <p class="small">No hay citas@(estadoFiltro != null ? " con este estado" : "")</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (Talleres360.Dtos.Citas.CitaDto c in Model.Data)
                    {
                        string nombreCliente = c.ClienteNombre
                            ?? c.NombreClienteTemp
                            ?? "Sin cliente";
                        <tr>
                            <td>
                                <div class="fw-semibold small" style="color:var(--c-text);">@nombreCliente</div>
                                @if (!string.IsNullOrEmpty(c.VehiculoMatricula))
                                {
                                    <div class="small" style="color:var(--c-text-muted);">
                                        @c.VehiculoMatricula
                                        @if (!string.IsNullOrEmpty(c.VehiculoMarca))
                                        {
                                            <span>— @c.VehiculoMarca @c.VehiculoModelo</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="d-none d-sm-table-cell small" style="color:var(--c-text-secondary);">
                                @c.FechaCita.ToString("dd/MM/yyyy")
                            </td>
                            <td class="d-none d-md-table-cell small" style="color:var(--c-text-muted);">
                                @(c.HoraAproximada ?? "—")
                            </td>
                            <td class="d-none d-md-table-cell small" style="color:var(--c-text-muted);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                @(c.Descripcion ?? "—")
                            </td>
                            <td>
                                <span class="badge @BadgeClass(c.Estado)">@BadgeLabel(c.Estado)</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1 justify-content-end">
                                    <a asp-action="Editar" asp-route-id="@c.Id"
                                       class="btn btn-secondary btn-sm" title="Editar">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </a>
                                    @if (c.Estado != CitaEstado.CANCELADA && c.Estado != CitaEstado.COMPLETADA)
                                    {
                                        <form asp-action="Convertir" asp-route-id="@c.Id" method="post"
                                              data-confirm-title="Convertir a trabajo"
                                              data-confirm-msg="Se creará una orden de trabajo a partir de esta cita."
                                              data-confirm-variant="primary">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-secondary btn-sm" title="Convertir a trabajo">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                                    <polyline points="14 2 14 8 20 8"/>
                                                    <line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/>
                                                </svg>
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="Eliminar" asp-route-id="@c.Id" method="post"
                                          data-confirm-title="Eliminar cita"
                                          data-confirm-msg="Esta acción no se puede deshacer.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" title="Eliminar">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                <path d="M10 11v6"/><path d="M14 11v6"/>
                                                <path d="M9 6V4h6v2"/>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination")

</div>
