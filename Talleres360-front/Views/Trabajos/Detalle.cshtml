@model Talleres360.Dtos.Trabajos.TrabajoDto
@using Talleres360.Enums
@using Talleres360.Dtos.Trabajos
@{
    ViewData["Title"] = $"Trabajo {Model.NumeroDocumento ?? $"#{Model.Id}"}";
    List<DetalleTrabajoDto> lineas = ViewData["Lineas"] as List<DetalleTrabajoDto> ?? new();
    List<CobroTrabajoDto>   cobros = ViewData["Cobros"] as List<CobroTrabajoDto>   ?? new();
    
    var productos = ViewData["ProductosCatalog"] as List<Talleres360.Dtos.Inventario.ProductoDto> ?? new();
    var servicios = ViewData["ServiciosCatalog"] as List<Talleres360.Dtos.Servicios.ServicioDto> ?? new();

    // Totales calculados desde las líneas (fuente de verdad en tiempo real)
    decimal subtotalLineas = lineas.Sum(l => l.Cantidad * l.PrecioUnitario * (1 - l.DescuentoPorcentaje / 100));
    decimal ivaLineas      = lineas.Sum(l => l.Cantidad * l.PrecioUnitario * (1 - l.DescuentoPorcentaje / 100) * l.ImpuestoPorcentaje / 100);
    decimal totalLineas    = subtotalLineas + ivaLineas;

    decimal totalCobrado = cobros.Sum(c => c.Importe);
    decimal porcentaje   = totalLineas > 0 ? Math.Min(totalCobrado / totalLineas * 100, 100) : 0;
    decimal pendiente    = totalLineas - totalCobrado;

    string EstadoClass(TrabajoEstado e) => e switch {
        TrabajoEstado.ABIERTO          => "badge-activo",
        TrabajoEstado.EN_PROCESO       => "badge-en-curso",
        TrabajoEstado.PENDIENTE_PIEZAS => "badge-parcial",
        TrabajoEstado.CERRADO          => "badge-pagado",
        TrabajoEstado.FACTURADO        => "badge-pagado",
        TrabajoEstado.CANCELADO        => "badge-inactivo",
        _                              => "badge-pendiente"
    };
    string EstadoLabel(TrabajoEstado e) => e switch {
        TrabajoEstado.ABIERTO             => "Abierto",
        TrabajoEstado.EN_PROCESO          => "En proceso",
        TrabajoEstado.PENDIENTE_PIEZAS    => "Pendiente piezas",
        TrabajoEstado.CERRADO             => "Cerrado",
        TrabajoEstado.FACTURADO           => "Facturado",
        TrabajoEstado.CANCELADO           => "Cancelado",
        TrabajoEstado.PRESUPUESTO         => "Presupuesto",
        TrabajoEstado.PRESUPUESTO_ENVIADO => "Presupuesto enviado",
        _                                 => e.ToString()
    };
    string PagoClass(TrabajoEstadoPago p) => p switch {
        TrabajoEstadoPago.PENDIENTE => "badge-pendiente",
        TrabajoEstadoPago.PARCIAL   => "badge-parcial",
        TrabajoEstadoPago.PAGADO    => "badge-pagado",
        TrabajoEstadoPago.ANULADO   => "badge-inactivo",
        _                           => "badge-inactivo"
    };
    string PagoLabel(TrabajoEstadoPago p) => p switch {
        TrabajoEstadoPago.PENDIENTE => "Pendiente",
        TrabajoEstadoPago.PARCIAL   => "Parcial",
        TrabajoEstadoPago.PAGADO    => "Pagado",
        TrabajoEstadoPago.ANULADO   => "Anulado",
        _                           => p.ToString()
    };
    string BarraColor = Model.EstadoPago switch {
        TrabajoEstadoPago.PAGADO  => "var(--c-green)",
        TrabajoEstadoPago.PARCIAL => "var(--c-yellow)",
        _                         => "var(--c-text-muted)"
    };
}

@* ── Cabecera de página ── *@
<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="link-muted-360">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
        </a>
        <div>
            <h1 class="page-title">@(Model.NumeroDocumento ?? $"Trabajo #{Model.Id}")</h1>
            <p class="page-subtitle">@(Model.TituloMantenimiento ?? "Orden de servicio")</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-secondary btn-md">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            Editar
        </a>
        @if (Model.Estado == TrabajoEstado.CERRADO)
        {
            <form asp-action="Facturar" asp-route-id="@Model.Id" method="post"
                  data-confirm-title="Facturar trabajo"
                  data-confirm-msg="Se generará la factura de este trabajo.">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary btn-md">Facturar</button>
            </form>
        }
        <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post"
              data-confirm-title="Eliminar trabajo"
              data-confirm-msg="Esta acción eliminará la orden y no se puede deshacer.">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger btn-md">Eliminar</button>
        </form>
    </div>
</div>

@* ── Tarjetas de resumen ── *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card" style="padding:16px;">
            <div class="small" style="color:var(--c-text-muted);">Estado</div>
            <div class="mt-1"><span class="badge @EstadoClass(Model.Estado)">@EstadoLabel(Model.Estado)</span></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card" style="padding:16px;">
            <div class="small" style="color:var(--c-text-muted);">Pago</div>
            <div class="mt-1"><span class="badge @PagoClass(Model.EstadoPago)">@PagoLabel(Model.EstadoPago)</span></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card" style="padding:16px;">
            <div class="small" style="color:var(--c-text-muted);">Total</div>
            <div class="fw-semibold mt-1" style="color:var(--c-text);font-size:18px;">@totalLineas.ToString("N2") €</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card" style="padding:16px;">
            <div class="small" style="color:var(--c-text-muted);">Pendiente</div>
            <div class="fw-semibold mt-1" style="color:@(pendiente > 0 ? "var(--c-red)" : "var(--c-green)");font-size:18px;">
                @pendiente.ToString("N2") €
            </div>
        </div>
    </div>
</div>

@* ── Barra de progreso de cobro ── *@
<div class="card mb-4" style="padding:16px 20px;">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="small fw-semibold" style="color:var(--c-text);">Cobrado</span>
        <span class="small" style="color:var(--c-text-muted);">@totalCobrado.ToString("N2") € / @totalLineas.ToString("N2") €</span>
    </div>
    <div style="background:var(--c-surface-2,rgba(255,255,255,0.06));border-radius:8px;height:8px;overflow:hidden;">
        <div style="width:@porcentaje.ToString("F1")%;height:100%;background:@BarraColor;border-radius:8px;transition:width .3s ease;"></div>
    </div>
    <div class="mt-1 small" style="color:var(--c-text-muted);">@porcentaje.ToString("F0")% cobrado</div>
</div>

<div class="row g-4">

    @* ── Columna izquierda: info + líneas ── *@
    <div class="col-12 col-lg-7">

        @* Info del trabajo *@
        @if (Model.VehiculoId.HasValue || Model.KmEntrada > 0 || Model.FechaEntregaEstimada.HasValue)
        {
            <div class="card mb-4" style="padding:16px 20px;">
                <div class="small fw-semibold mb-3" style="color:var(--c-text-muted);text-transform:uppercase;letter-spacing:.05em;">Datos del trabajo</div>
                <div class="row g-2">
                    @if (Model.VehiculoId.HasValue)
                    {
                        <div class="col-6">
                            <div class="small" style="color:var(--c-text-muted);">Vehículo</div>
                            <div class="small fw-semibold">#@Model.VehiculoId</div>
                        </div>
                    }
                    @if (Model.KmEntrada > 0)
                    {
                        <div class="col-6">
                            <div class="small" style="color:var(--c-text-muted);">Km entrada</div>
                            <div class="small fw-semibold">@Model.KmEntrada.ToString("N0") km</div>
                        </div>
                    }
                    @if (Model.KmSalida.HasValue)
                    {
                        <div class="col-6">
                            <div class="small" style="color:var(--c-text-muted);">Km salida</div>
                            <div class="small fw-semibold">@Model.KmSalida.Value.ToString("N0") km</div>
                        </div>
                    }
                    @if (Model.FechaEntregaEstimada.HasValue)
                    {
                        <div class="col-6">
                            <div class="small" style="color:var(--c-text-muted);">Entrega estimada</div>
                            <div class="small fw-semibold">@Model.FechaEntregaEstimada.Value.ToString("dd/MM/yyyy")</div>
                        </div>
                    }
                    <div class="col-6">
                        <div class="small" style="color:var(--c-text-muted);">Creado</div>
                        <div class="small fw-semibold">@Model.FechaCreacion.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.TrabajoRealizado))
                {
                    <div class="mt-3 pt-3 border-top" style="border-color:var(--c-border);">
                        <div class="small" style="color:var(--c-text-muted);">Trabajo realizado</div>
                        <div class="small mt-1">@Model.TrabajoRealizado</div>
                    </div>
                }
            </div>
        }

        @* Tabla de líneas *@
        <div class="table-card">
            <div class="table-toolbar">
                <span class="fw-semibold" style="color:var(--c-text);">Líneas del trabajo</span>
                <span class="small" style="color:var(--c-text-muted);">@lineas.Count línea@(lineas.Count != 1 ? "s" : "")</span>
            </div>
            <div class="table-wrap">
                <table class="t360">
                    <thead>
                        <tr>
                            <th>Concepto</th>
                            <th class="text-end" style="width:60px;">Cant.</th>
                            <th class="text-end d-none d-sm-table-cell" style="width:90px;">P. Unit.</th>
                            <th class="text-end d-none d-md-table-cell" style="width:70px;">Dto %</th>
                            <th class="text-end" style="width:90px;">Subtotal</th>
                            <th style="width:40px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!lineas.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4" style="color:var(--c-text-muted);">
                                    <p class="small mb-0">Sin líneas. Añade productos, servicios o mano de obra.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (DetalleTrabajoDto l in lineas)
                            {
                                decimal sub = l.Cantidad * l.PrecioUnitario * (1 - l.DescuentoPorcentaje / 100);
                                <tr>
                                    <td>
                                        <div class="small fw-semibold">@l.Concepto</div>
                                        @if (l.EsManoObra)
                                        {
                                            <span class="badge badge-en-curso" style="font-size:10px;">Mano de obra</span>
                                        }
                                    </td>
                                    <td class="text-end small">@l.Cantidad.ToString("N2")</td>
                                    <td class="text-end small d-none d-sm-table-cell">@l.PrecioUnitario.ToString("N2") €</td>
                                    <td class="text-end small d-none d-md-table-cell">
                                        @(l.DescuentoPorcentaje > 0 ? $"{l.DescuentoPorcentaje:N0}%" : "—")
                                    </td>
                                    <td class="text-end small fw-semibold">@sub.ToString("N2") €</td>
                                    <td>
                                        <form asp-action="EliminarLinea" asp-route-id="@Model.Id" asp-route-lineaId="@l.Id"
                                              method="post" data-confirm-title="Eliminar línea"
                                              data-confirm-msg="Se eliminará esta línea del trabajo.">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm" title="Eliminar">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                                                </svg>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    @if (lineas.Any())
                    {
                        <tfoot>
                            <tr style="border-top:2px solid var(--c-border);">
                                <td colspan="4" class="text-end small" style="color:var(--c-text-muted);">Subtotal</td>
                                <td class="text-end small fw-semibold">@subtotalLineas.ToString("N2") €</td>
                                <td></td>
                            </tr>
                            <tr>
                                <td colspan="4" class="text-end small" style="color:var(--c-text-muted);">IVA</td>
                                <td class="text-end small fw-semibold">@ivaLineas.ToString("N2") €</td>
                                <td></td>
                            </tr>
                            <tr>
                                <td colspan="4" class="text-end fw-semibold" style="color:var(--c-text);">Total</td>
                                <td class="text-end fw-semibold" style="color:var(--c-text);font-size:15px;">@totalLineas.ToString("N2") €</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>

            @* Formulario nueva línea *@
            <div style="padding:16px 20px;border-top:1px solid var(--c-border);">
                <div class="small fw-semibold mb-3" style="color:var(--c-text);">Añadir línea</div>
                
                <div class="mb-3">
                    <label class="form-label small" style="color:var(--c-text-muted);">Cargar desde catálogo (Opcional)</label>
                    <select id="catalogoSelector" class="form-select" onchange="cargarDesdeCatalogo(this)">
                        <option value="">— Seleccionar Producto o Servicio —</option>
                        @if (servicios.Any())
                        {
                            <optgroup label="Servicios">
                                @foreach (var s in servicios)
                                {
                                    <option value="S_@s.Id" data-nombre="@s.Nombre" data-precio="@s.PrecioBase.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-iva="@s.ImpuestoPorcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-esmanoobra="true">@s.Nombre (@s.PrecioBase.ToString("N2") €)</option>
                                }
                            </optgroup>
                        }
                        @if (productos.Any())
                        {
                            <optgroup label="Productos">
                                @foreach (var p in productos)
                                {
                                    <option value="P_@p.Id" data-id="@p.Id" data-nombre="@p.Nombre" data-precio="@p.PrecioVenta.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-iva="21" data-esmanoobra="false">@p.Nombre (@p.PrecioVenta.ToString("N2") €)</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>

                <form asp-action="AgregarLinea" asp-route-id="@Model.Id" method="post" asp-antiforgery="true">
                    <input type="hidden" id="ProductoId" name="lineaForm.ProductoId" value="" />
            <div class="row g-2">
                        <div class="col-12 col-sm-5">
                            <input id="Concepto" name="lineaForm.Concepto" class="form-input" placeholder="Concepto *" required maxlength="255" />
                        </div>
                        <div class="col-6 col-sm-2">
                            <input id="Cantidad" name="lineaForm.Cantidad" type="number" step="0.001" min="0.001" value="1"
                                   class="form-input" placeholder="Cant." required />
                        </div>
                        <div class="col-6 col-sm-2">
                            <input id="PrecioUnitario" name="lineaForm.PrecioUnitario" type="number" step="0.01" min="0" value="0"
                                   class="form-input" placeholder="Precio €" required />
                        </div>
                        <div class="col-6 col-sm-2">
                            <input id="Descuento" name="lineaForm.DescuentoPorcentaje" type="number" step="1" min="0" max="100" value="0"
                                   class="form-input" placeholder="Dto %" />
                        </div>
                        <div class="col-6 col-sm-1">
                            <input id="Iva" name="lineaForm.ImpuestoPorcentaje" type="number" step="1" min="0" max="100" value="21"
                                   class="form-input" placeholder="IVA %" />
                        </div>
                        <div class="col-12 d-flex gap-2 mt-1">
                            <label class="d-flex align-items-center gap-2 small" style="color:var(--c-text-muted);cursor:pointer;">
                                <input id="EsManoObra" name="lineaForm.EsManoObra" type="checkbox" value="true" />
                                Mano de obra / Taller
                            </label>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-3">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                            </svg>
                            Agregar
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </div>

    @* ── Columna derecha: cobros ── *@
    <div class="col-12 col-lg-5">
        <div class="table-card">
            <div class="table-toolbar">
                <span class="fw-semibold" style="color:var(--c-text);">Cobros</span>
                <span class="small" style="color:var(--c-text-muted);">@cobros.Count cobro@(cobros.Count != 1 ? "s" : "")</span>
            </div>
            <div class="table-wrap">
                <table class="t360">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Método</th>
                            <th class="text-end">Importe</th>
                            <th style="width:40px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!cobros.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4" style="color:var(--c-text-muted);">
                                    <p class="small mb-0">Sin cobros registrados.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (CobroTrabajoDto c in cobros)
                            {
                                <tr>
                                    <td class="small">@c.FechaCobro.ToString("dd/MM/yy")</td>
                                    <td class="small">@(c.MetodoPago?.ToString() ?? "—")</td>
                                    <td class="text-end small fw-semibold">@c.Importe.ToString("N2") €</td>
                                    <td>
                                        <form asp-action="EliminarCobro" asp-route-id="@Model.Id" asp-route-cobroId="@c.Id"
                                              method="post" data-confirm-title="Eliminar cobro"
                                              data-confirm-msg="Se eliminará este cobro.">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm" title="Eliminar">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                                                </svg>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @* Formulario nuevo cobro *@
            <div style="padding:16px 20px;border-top:1px solid var(--c-border);">
                <div class="small fw-semibold mb-3" style="color:var(--c-text);">Registrar cobro</div>
                <form asp-action="RegistrarCobro" asp-route-id="@Model.Id" method="post" asp-antiforgery="true">
                    <div class="row g-2">
                        <div class="col-12 col-sm-6">
                            <input name="cobroForm.Importe" type="text"
                                   class="form-input" placeholder="Importe € *" required />
                        </div>
                        <div class="col-12 col-sm-6">
                            <select name="cobroForm.MetodoPago" class="form-select">
                                <option value="EFECTIVO">Efectivo</option>
                                <option value="TARJETA">Tarjeta</option>
                                <option value="TRANSFERENCIA">Transferencia</option>
                                <option value="BIZUM">Bizum</option>
                                <option value="OTRO">Otro</option>
                            </select>
                        </div>
                        <div class="col-12 col-sm-6">
                            <input name="cobroForm.FechaCobro" type="date"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   class="form-input" required />
                        </div>
                        <div class="col-12 col-sm-6">
                            <input name="cobroForm.Referencia" class="form-input" placeholder="Referencia (opcional)" maxlength="100" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-3 align-items-center">
                        <div asp-validation-summary="All" class="text-danger small mb-0"></div>
                        <button type="submit" class="btn btn-primary btn-sm">Registrar cobro</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>
