@model Talleres360.Dtos.PagedResponse<Talleres360.Dtos.Trabajos.TrabajoDto>
@using Talleres360.Enums
@{
    ViewData["Title"] = "Trabajos";
    string? estadoFiltro     = ViewData["EstadoFiltro"]     as string;
    string? estadoPagoFiltro = ViewData["EstadoPagoFiltro"] as string;

    string EstadoClass(TrabajoEstado e) => e switch {
        TrabajoEstado.ABIERTO           => "badge-activo",
        TrabajoEstado.EN_PROCESO        => "badge-en-curso",
        TrabajoEstado.PENDIENTE_PIEZAS  => "badge-parcial",
        TrabajoEstado.CERRADO           => "badge-pagado",
        TrabajoEstado.FACTURADO         => "badge-pagado",
        TrabajoEstado.CANCELADO         => "badge-inactivo",
        TrabajoEstado.PRESUPUESTO       => "badge-pendiente",
        TrabajoEstado.PRESUPUESTO_ENVIADO => "badge-en-curso",
        TrabajoEstado.RECHAZADO         => "badge-inactivo",
        TrabajoEstado.CADUCADO          => "badge-inactivo",
        _                               => "badge-inactivo"
    };
    string EstadoLabel(TrabajoEstado e) => e switch {
        TrabajoEstado.ABIERTO             => "Abierto",
        TrabajoEstado.EN_PROCESO          => "En proceso",
        TrabajoEstado.PENDIENTE_PIEZAS    => "Pendiente piezas",
        TrabajoEstado.CERRADO             => "Cerrado",
        TrabajoEstado.FACTURADO           => "Facturado",
        TrabajoEstado.CANCELADO           => "Cancelado",
        TrabajoEstado.PRESUPUESTO         => "Presupuesto",
        TrabajoEstado.PRESUPUESTO_ENVIADO => "Presupuesto enviado",
        TrabajoEstado.RECHAZADO           => "Rechazado",
        TrabajoEstado.CADUCADO            => "Caducado",
        _                                 => e.ToString()
    };
    string PagoClass(TrabajoEstadoPago p) => p switch {
        TrabajoEstadoPago.PENDIENTE => "badge-pendiente",
        TrabajoEstadoPago.PARCIAL   => "badge-parcial",
        TrabajoEstadoPago.PAGADO    => "badge-pagado",
        TrabajoEstadoPago.ANULADO   => "badge-inactivo",
        _                           => "badge-inactivo"
    };
    string PagoLabel(TrabajoEstadoPago p) => p switch {
        TrabajoEstadoPago.PENDIENTE => "Pendiente",
        TrabajoEstadoPago.PARCIAL   => "Parcial",
        TrabajoEstadoPago.PAGADO    => "Pagado",
        TrabajoEstadoPago.ANULADO   => "Anulado",
        _                           => p.ToString()
    };
}

<div class="page-header">
    <div>
        <h1 class="page-title">Trabajos</h1>
        <p class="page-subtitle">Órdenes de servicio del taller</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary btn-md">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Nueva orden
    </a>
</div>

<div class="table-card">

    @* Filtros *@
    <div class="table-toolbar" style="flex-wrap:wrap;gap:8px;">
        <div class="d-flex gap-2 flex-wrap align-items-center">

            <span class="small fw-semibold" style="color:var(--c-text-muted);">Estado:</span>
            <a asp-action="Index" asp-route-estadoPago="@estadoPagoFiltro"
               class="btn btn-sm @(estadoFiltro == null ? "btn-primary" : "btn-secondary")">Todos</a>
            @foreach (TrabajoEstado e in new[] {
                TrabajoEstado.ABIERTO, TrabajoEstado.EN_PROCESO,
                TrabajoEstado.PENDIENTE_PIEZAS, TrabajoEstado.CERRADO, TrabajoEstado.CANCELADO })
            {
                string v = e.ToString();
                <a asp-action="Index" asp-route-estado="@v" asp-route-estadoPago="@estadoPagoFiltro"
                   class="btn btn-sm @(estadoFiltro == v ? "btn-primary" : "btn-secondary")">
                    @EstadoLabel(e)
                </a>
            }

            <span class="small fw-semibold ms-3" style="color:var(--c-text-muted);">Pago:</span>
            <a asp-action="Index" asp-route-estado="@estadoFiltro"
               class="btn btn-sm @(estadoPagoFiltro == null ? "btn-primary" : "btn-secondary")">Todos</a>
            @foreach (TrabajoEstadoPago p in Enum.GetValues<TrabajoEstadoPago>())
            {
                string v = p.ToString();
                <a asp-action="Index" asp-route-estado="@estadoFiltro" asp-route-estadoPago="@v"
                   class="btn btn-sm @(estadoPagoFiltro == v ? "btn-primary" : "btn-secondary")">
                    @PagoLabel(p)
                </a>
            }
        </div>
        <span class="small ms-auto" style="color:var(--c-text-muted);white-space:nowrap;">
            @(ViewData["TotalCount"]) trabajo@((int)(ViewData["TotalCount"] ?? 0) != 1 ? "s" : "")
        </span>
    </div>

    <div class="table-wrap">
        <table class="t360">
            <thead>
                <tr>
                    <th>Nº / Título</th>
                    <th class="d-none d-sm-table-cell">Vehículo</th>
                    <th>Estado</th>
                    <th class="d-none d-md-table-cell">Pago</th>
                    <th class="d-none d-lg-table-cell text-end">Total</th>
                    <th class="d-none d-sm-table-cell">Fecha</th>
                    <th style="width:80px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Data.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5" style="color:var(--c-text-muted);">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="d-block mx-auto mb-3" style="opacity:0.4;">
                                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                <line x1="8" y1="21" x2="16" y2="21"/>
                                <line x1="12" y1="17" x2="12" y2="21"/>
                            </svg>
                            <p class="small">No hay trabajos@(estadoFiltro != null || estadoPagoFiltro != null ? " con estos filtros" : "")</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (Talleres360.Dtos.Trabajos.TrabajoDto t in Model.Data)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold small" style="color:var(--c-text);">
                                    @(t.NumeroDocumento ?? $"#{t.Id}")
                                </div>
                                @if (!string.IsNullOrEmpty(t.TituloMantenimiento))
                                {
                                    <div class="small" style="color:var(--c-text-muted);max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                        @t.TituloMantenimiento
                                    </div>
                                }
                            </td>
                            <td class="d-none d-sm-table-cell small" style="color:var(--c-text-secondary);">
                                @if (t.VehiculoId.HasValue)
                                {
                                    <span>Veh. #@t.VehiculoId</span>
                                }
                                else
                                {
                                    <span style="color:var(--c-text-muted);">—</span>
                                }
                            </td>
                            <td><span class="badge @EstadoClass(t.Estado)">@EstadoLabel(t.Estado)</span></td>
                            <td class="d-none d-md-table-cell">
                                <span class="badge @PagoClass(t.EstadoPago)">@PagoLabel(t.EstadoPago)</span>
                            </td>
                            <td class="d-none d-lg-table-cell text-end small fw-semibold" style="color:var(--c-text);">
                                @t.Total.ToString("N2") €
                            </td>
                            <td class="d-none d-sm-table-cell small" style="color:var(--c-text-muted);">
                                @t.FechaCreacion.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1 justify-content-end">
                                    <a asp-action="Detalle" asp-route-id="@t.Id"
                                       class="btn btn-secondary btn-sm" title="Ver detalle">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                            <circle cx="12" cy="12" r="3"/>
                                        </svg>
                                    </a>
                                    <a asp-action="Editar" asp-route-id="@t.Id"
                                       class="btn btn-secondary btn-sm" title="Editar">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </a>
                                    <form asp-action="Eliminar" asp-route-id="@t.Id" method="post"
                                          data-confirm-title="Eliminar trabajo"
                                          data-confirm-msg="Esta acción no se puede deshacer.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" title="Eliminar">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                <path d="M10 11v6"/><path d="M14 11v6"/>
                                                <path d="M9 6V4h6v2"/>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination")

</div>
