@model Talleres360.Dtos.PagedResponse<Talleres360.Models.Flota.VehiculoDetalle>
@{
    ViewData["Title"] = "Vehículos";
    string? buscar = ViewData["Buscar"] as string;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Vehículos</h1>
        <p class="page-subtitle">Vehículos registrados en el taller</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary btn-md">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Nuevo vehículo
    </a>
</div>

<div class="table-card">

    <div class="table-toolbar">
        <div class="search-bar w-100 w-sm-auto flex-sm-grow-1">
            <span class="search-bar-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
            </span>
            <input id="search-input" type="search" class="search-input"
                   placeholder="Buscar por matrícula…"
                   value="@buscar" autocomplete="off" />
        </div>
        <span class="small ms-auto d-none d-sm-inline" style="color:var(--c-text-muted);">
            @(ViewData["TotalCount"]) vehículo@((int)(ViewData["TotalCount"] ?? 0) != 1 ? "s" : "")
        </span>
    </div>

    <div class="table-wrap">
        <table class="t360">
            <thead>
                <tr>
                    <th>Matrícula</th>
                    <th class="d-none d-sm-table-cell">Marca / Modelo</th>
                    <th class="d-none d-md-table-cell">Tipo</th>
                    <th class="d-none d-lg-table-cell">Año</th>
                    <th class="d-none d-lg-table-cell">Km</th>
                    <th style="width:80px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Data.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5" style="color:var(--c-text-muted);">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="d-block mx-auto mb-3" style="opacity:0.4;">
                                <rect x="1" y="3" width="15" height="13" rx="2"/>
                                <path d="M16 8h5l2 4v4h-7V8z"/>
                                <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                            </svg>
                            <p class="small">No hay vehículos que coincidan</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (Talleres360.Models.Flota.VehiculoDetalle v in Model.Data)
                    {
                        string iniciales = (v.MarcaNombre.Length > 0 ? v.MarcaNombre[0].ToString() : "V").ToUpper();
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:32px;height:32px;border-radius:6px;background:var(--c-accent-soft);color:var(--c-accent);font-size:0.75rem;font-weight:700;">
                                        @iniciales
                                    </div>
                                    <div>
                                        <div class="fw-semibold small" style="color:var(--c-text);">
                                            @v.Matricula
                                        </div>
                                        @if (v.TieneAviso == 1)
                                        {
                                            <span class="badge badge-aviso">Aviso</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="d-none d-sm-table-cell small" style="color:var(--c-text-secondary);">
                                @v.MarcaNombre @v.ModeloNombre
                            </td>
                            <td class="d-none d-md-table-cell small" style="color:var(--c-text-muted);">
                                @v.TipoNombre
                            </td>
                            <td class="d-none d-lg-table-cell small" style="color:var(--c-text-muted);">
                                @(v.Anio.HasValue ? v.Anio.Value.ToString() : "—")
                            </td>
                            <td class="d-none d-lg-table-cell small" style="color:var(--c-text-muted);">
                                @(v.KmActuales.HasValue ? $"{v.KmActuales.Value:N0} km" : "—")
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2 justify-content-end">
                                    <a asp-action="Editar" asp-route-id="@v.Id"
                                       class="btn btn-secondary btn-sm" title="Editar">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </a>
                                    <form asp-action="Eliminar" asp-route-id="@v.Id" method="post"
                                          data-confirm-title="Eliminar vehículo"
                                          data-confirm-msg="Se eliminará @v.Matricula. Esta acción no se puede deshacer.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" title="Eliminar">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                <path d="M10 11v6"/><path d="M14 11v6"/>
                                                <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination")

</div>

@section Scripts {
<script>
let searchTimer;
document.getElementById('search-input').addEventListener('input', function () {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
        const q = this.value.trim();
        window.location.href = q
            ? `?buscar=${encodeURIComponent(q)}&pageNumber=1`
            : '?pageNumber=1';
    }, 350);
});
</script>
}
