@model Talleres360.Dtos.Auth.LoginRequest
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutAuth";
}

<div class="auth-card">
    <!-- Logo -->
    <div class="auth-logo">
        <svg width="40" height="40" viewBox="0 0 56 56" fill="none">
            <path d="M14 10 A24 24 0 1 0 42 10" stroke="oklch(0.68 0.18 245)" stroke-width="3" stroke-linecap="round" fill="none" />
            <circle cx="14" cy="10" r="4" fill="oklch(0.68 0.18 245)" />
            <circle cx="42" cy="10" r="4" fill="oklch(0.68 0.18 245)" />
            <rect x="25.5" y="26" width="5" height="20" rx="2.5" fill="white" />
            <rect x="20" y="25" width="16" height="4" rx="2" fill="white" />
        </svg>
        <div>
            <div class="auth-logo-name">Talleres<span>360</span></div>
            <div class="auth-logo-sub">Gestión de talleres</div>
        </div>
    </div>

    <h1 class="auth-title">Bienvenido de nuevo</h1>
    <p class="auth-subtitle">Accede a la gestión de tu taller</p>

    @if (!Html.ViewData.ModelState.IsValid && Html.ViewData.ModelState.ContainsKey(string.Empty))
    {
    <div class="auth-error-box mb-3">
        @Html.ValidationSummary(true)
    </div>
    }

    <form method="post" class="auth-form" asp-antiforgery="true">
        @if (ViewData["ReturnUrl"] is string returnUrl)
        {
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        }

        <div class="auth-form-group mb-3">
            <label asp-for="Email" class="auth-label form-label">Correo electrónico</label>
            <div class="auth-input-wrap position-relative">
                <span class="auth-input-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                        <polyline points="22,6 12,13 2,6" />
                    </svg>
                </span>
                <input asp-for="Email" type="email" class="auth-input form-control"
                       placeholder="taller@ejemplo.com"
                       autocomplete="email" autofocus />
            </div>
            <span asp-validation-for="Email" class="field-error invalid-feedback d-block"></span>
        </div>

        <div class="auth-form-group mb-3">
            <label asp-for="Password" class="auth-label form-label">Contraseña</label>
            <div class="auth-input-wrap position-relative">
                <span class="auth-input-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                </span>
                <input asp-for="Password" type="password" class="auth-input form-control"
                       placeholder="••••••••"
                       autocomplete="current-password" />
            </div>
            <span asp-validation-for="Password" class="field-error invalid-feedback d-block"></span>
        </div>

        <button type="submit" class="auth-btn btn w-100 mt-1">
            Iniciar sesión
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
            </svg>
        </button>
    </form>

    <div class="auth-footer mt-4 text-center">
        ¿No tienes cuenta? <a asp-controller="Auth" asp-action="Register">Registra tu taller</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}