@model Talleres360.Dtos.PagedResponse<Talleres360.Dtos.Inventario.ProductoDto>
@using Talleres360.Dtos.Inventario
@{
    ViewData["Title"] = "Inventario de Productos";
    string? buscar = ViewData["Buscar"] as string;
    int? categoriaId = ViewData["CategoriaId"] as int?;
    List<CategoriaProductoDto> categorias = ViewData["Categorias"] as List<CategoriaProductoDto> ?? new();
}

<div class="page-header">
    <div>
        <h1 class="page-title">Productos</h1>
        <p class="page-subtitle">Gestión de stock e inventario</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Categorias" class="btn btn-secondary btn-md">
            Categorías
        </a>
        <a asp-action="Crear" class="btn btn-primary btn-md">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Nuevo producto
        </a>
    </div>
</div>

<div class="table-card">

    @* Barra de herramientas superior *@
    <div class="table-toolbar">
        <form method="get" asp-action="Productos" class="d-flex align-items-center gap-2 flex-grow-1" style="max-width:600px;">
            
            <div class="position-relative flex-grow-1">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="position-absolute" style="left:12px;top:50%;transform:translateY(-50%);color:var(--c-text-muted);">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" name="buscar" value="@buscar" class="form-input w-100" placeholder="Buscar por referencia o nombre..." style="padding-left:36px;" />
            </div>

            <select name="categoriaId" class="form-select w-auto" onchange="this.form.submit()">
                <option value="">Todas las categorías</option>
                @foreach (var c in categorias)
                {
                    if (categoriaId == c.Id)
                    {
                        <option value="@c.Id" selected>@c.Nombre</option>
                    }
                    else
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                }
            </select>

            <button type="submit" class="d-none">Buscar</button>
            @if (!string.IsNullOrEmpty(buscar) || categoriaId.HasValue)
            {
                <a asp-action="Productos" class="btn btn-secondary btn-sm" title="Limpiar filtros">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </a>
            }
        </form>

        <span class="small ms-auto" style="color:var(--c-text-muted);white-space:nowrap;">
            @(ViewData["TotalCount"]) producto@((int)(ViewData["TotalCount"] ?? 0) != 1 ? "s" : "")
        </span>
    </div>

    <div class="table-wrap">
        <table class="t360">
            <thead>
                <tr>
                    <th>Ref. / Nombre</th>
                    <th class="d-none d-md-table-cell">Categoría</th>
                    <th class="text-end d-none d-sm-table-cell">Precio Compra</th>
                    <th class="text-end">Precio Venta</th>
                    <th class="text-center">Stock</th>
                    <th style="width:80px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Data.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5" style="color:var(--c-text-muted);">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="d-block mx-auto mb-3" style="opacity:0.4;">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                <line x1="3" y1="9" x2="21" y2="9"/>
                                <line x1="9" y1="21" x2="9" y2="9"/>
                            </svg>
                            <p class="small">No se encontraron productos.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var p in Model.Data)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(p.Referencia))
                                {
                                    <div class="small" style="color:var(--c-text-muted);">@p.Referencia</div>
                                }
                                <div class="fw-semibold small" style="color:var(--c-text);">@p.Nombre</div>
                            </td>
                            <td class="d-none d-md-table-cell small" style="color:var(--c-text-secondary);">
                                @p.CategoriaNombre
                            </td>
                            <td class="text-end d-none d-sm-table-cell small" style="color:var(--c-text-secondary);">
                                @p.PrecioCompra.ToString("N2") €
                            </td>
                            <td class="text-end small fw-semibold" style="color:var(--c-text);">
                                @p.PrecioVenta.ToString("N2") €
                            </td>
                            <td class="text-center">
                                @if (p.ControlarStock)
                                {
                                    if (p.StockActual <= 0)
                                    {
                                        <span class="badge badge-inactivo" title="Sin stock">@p.StockActual.ToString("N2")</span>
                                    }
                                    else if (p.StockActual <= 5)
                                    {
                                        <span class="badge badge-parcial" title="Stock bajo">@p.StockActual.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-activo">@p.StockActual.ToString("N2")</span>
                                    }
                                }
                                else
                                {
                                    <span class="small" style="color:var(--c-text-muted);">—</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1 justify-content-end">
                                    <a asp-action="Editar" asp-route-id="@p.Id"
                                       class="btn btn-secondary btn-sm" title="Editar">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </a>
                                    <form asp-action="Eliminar" asp-route-id="@p.Id" method="post"
                                          data-confirm-title="Eliminar producto"
                                          data-confirm-msg="Esta acción no se puede deshacer.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" title="Eliminar">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                <path d="M10 11v6"/><path d="M14 11v6"/>
                                                <path d="M9 6V4h6v2"/>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination")

</div>
