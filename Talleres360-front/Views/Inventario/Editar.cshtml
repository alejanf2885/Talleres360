@model Talleres360_front.Models.Inventario.ProductoFormModel
@using Talleres360.Dtos.Inventario
@{
    ViewData["Title"] = "Editar Producto";
    List<CategoriaProductoDto> categorias = ViewData["Categorias"] as List<CategoriaProductoDto> ?? new();
}

<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Productos" class="link-muted-360">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
        </a>
        <div>
            <h1 class="page-title">Editar producto</h1>
            <p class="page-subtitle">Modificar datos del inventario</p>
        </div>
    </div>
</div>

<div class="w-100" style="max-width:672px;">
    <div class="card">

        @if (!Html.ViewData.ModelState.IsValid && Html.ViewData.ModelState.ContainsKey(string.Empty))
        {
            <div class="mb-4 p-3 rounded-3 border" style="background:var(--c-red-soft);color:var(--c-red);border-color:rgba(12,18,30,0.15);">
                @Html.ValidationSummary(true)
            </div>
        }

        <form asp-action="Editar" asp-route-id="@Model.Id" method="post" asp-antiforgery="true">
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="form-group col-12 col-md-6">
                    <label asp-for="Referencia" class="form-label">Referencia / Código</label>
                    <input asp-for="Referencia" class="form-input" />
                    <span asp-validation-for="Referencia" class="form-error"></span>
                </div>

                <div class="form-group col-12 col-md-6">
                    <label asp-for="CategoriaId" class="form-label">Categoría <span style="color:var(--c-red);">*</span></label>
                    <select asp-for="CategoriaId" class="form-select">
                        <option value="">— Selecciona categoría —</option>
                        @foreach (var c in categorias)
                        {
                            <option value="@c.Id">@c.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="CategoriaId" class="form-error"></span>
                </div>

                <div class="form-group col-12">
                    <label asp-for="Nombre" class="form-label">Nombre del producto <span style="color:var(--c-red);">*</span></label>
                    <input asp-for="Nombre" class="form-input" />
                    <span asp-validation-for="Nombre" class="form-error"></span>
                </div>

                <div class="form-group col-6">
                    <label asp-for="PrecioCompra" class="form-label">Precio de Compra (€)</label>
                    <input asp-for="PrecioCompra" type="number" step="0.01" min="0" class="form-input" />
                    <span asp-validation-for="PrecioCompra" class="form-error"></span>
                </div>

                <div class="form-group col-6">
                    <label asp-for="PrecioVenta" class="form-label">Precio de Venta (€) <span style="color:var(--c-red);">*</span></label>
                    <input asp-for="PrecioVenta" type="number" step="0.01" min="0" class="form-input" />
                    <span asp-validation-for="PrecioVenta" class="form-error"></span>
                </div>

                <div class="form-group col-12 pt-2 border-top mt-3" style="border-color:var(--c-border);">
                    <label class="d-flex align-items-center gap-2 mb-3 cursor-pointer">
                        <input asp-for="ControlarStock" type="checkbox" onchange="document.getElementById('stockGroup').style.opacity = this.checked ? '1' : '0.5'; document.getElementById('StockActual').readOnly = !this.checked;" />
                        <span class="fw-semibold" style="color:var(--c-text);">Controlar Stock</span>
                    </label>
                </div>

                <div class="form-group col-6" id="stockGroup" style="opacity: @(Model.ControlarStock ? "1" : "0.5")">
                    <label asp-for="StockActual" class="form-label">Stock Actual</label>
                    <input asp-for="StockActual" type="number" step="0.01" class="form-input" readonly="@(!Model.ControlarStock ? "readonly" : null)" />
                    <span asp-validation-for="StockActual" class="form-error"></span>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-end gap-3 mt-4 pt-4 border-top" style="border-color:var(--c-border);">
                <a asp-action="Productos" class="btn btn-secondary btn-md">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-md">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
