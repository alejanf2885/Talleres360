@model List<Talleres360.Dtos.Inventario.CategoriaProductoDto>
@using Talleres360_front.Models.Inventario
@{
    ViewData["Title"] = "Categorías de Inventario";
    CategoriaFormModel formModel = ViewData["CategoriaForm"] as CategoriaFormModel ?? new();
}

<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Productos" class="link-muted-360">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
        </a>
        <div>
            <h1 class="page-title">Categorías</h1>
            <p class="page-subtitle">Gestionar familias de productos</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="table-card">
            <div class="table-wrap">
                <table class="t360">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th style="width:80px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="2" class="text-center py-5" style="color:var(--c-text-muted);">
                                    <p class="small">No hay categorías registradas.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var c in Model)
                            {
                                <tr>
                                    <td class="fw-semibold small" style="color:var(--c-text);">@c.Nombre</td>
                                    <td>
                                        <div class="d-flex align-items-center justify-content-end">
                                            <form asp-action="EliminarCategoria" asp-route-id="@c.Id" method="post"
                                                  data-confirm-title="Eliminar categoría"
                                                  data-confirm-msg="No podrás eliminarla si tiene productos asociados.">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger btn-sm" title="Eliminar">
                                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                        <polyline points="3 6 5 6 21 6"/>
                                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                    </svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card position-sticky" style="top:24px;">
            <div class="fw-semibold mb-3 pb-2 border-bottom" style="color:var(--c-text);border-color:var(--c-border) !important;">
                Nueva Categoría
            </div>
            
            <form asp-action="CrearCategoria" method="post" asp-antiforgery="true">
                <div class="form-group mb-3">
                    <label class="form-label">Nombre <span style="color:var(--c-red);">*</span></label>
                    <input name="Nombre" value="@formModel.Nombre" class="form-input" required maxlength="100" />
                </div>

                <button type="submit" class="btn btn-primary btn-md w-100">
                    Añadir categoría
                </button>
            </form>
        </div>
    </div>
</div>
