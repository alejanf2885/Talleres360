@model Talleres360.Dtos.PagedResponse<Talleres360.Dtos.Facturacion.FacturaDto>
@{
    ViewData["Title"] = "Facturas";

    string EstadoPagoClass(string? estado)
    {
        string estadoNormalizado = estado?.Trim().ToUpperInvariant() ?? string.Empty;
        return estadoNormalizado switch
        {
            "PAGADO" => "badge-pagado",
            "PARCIAL" => "badge-parcial",
            "PENDIENTE" => "badge-pendiente",
            "ANULADO" => "badge-inactivo",
            _ => "badge-inactivo"
        };
    }

    string EstadoPagoLabel(string? estado)
    {
        string estadoNormalizado = estado?.Trim().ToUpperInvariant() ?? string.Empty;
        return estadoNormalizado switch
        {
            "PAGADO" => "Pagado",
            "PARCIAL" => "Parcial",
            "PENDIENTE" => "Pendiente",
            "ANULADO" => "Anulado",
            _ => string.IsNullOrWhiteSpace(estado) ? "Sin estado" : estado
        };
    }
}

<div class="page-header">
    <div>
        <h1 class="page-title">Facturación</h1>
        <p class="page-subtitle">Listado de facturas emitidas</p>
    </div>
</div>

<div class="table-card">
    <div class="table-toolbar">
        <span class="small" style="color:var(--c-text-muted);">
            @(ViewData["TotalCount"]) factura@((int)(ViewData["TotalCount"] ?? 0) != 1 ? "s" : "") en total
        </span>
    </div>

    <div class="table-wrap">
        <table class="t360">
            <thead>
                <tr>
                    <th>Nº Factura</th>
                    <th class="d-none d-sm-table-cell">Cliente</th>
                    <th>Estado pago</th>
                    <th class="text-end">Total</th>
                    <th class="d-none d-sm-table-cell">Fecha emisión</th>
                    <th style="width:80px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Data.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5" style="color:var(--c-text-muted);">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="d-block mx-auto mb-3" style="opacity:0.4;">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                            <p class="small">No hay facturas emitidas.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (Talleres360.Dtos.Facturacion.FacturaDto factura in Model.Data)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold small" style="color:var(--c-text);">
                                    @factura.NumeroFactura
                                </div>
                                @if (factura.TrabajoId.HasValue)
                                {
                                    <div class="small" style="color:var(--c-text-muted);">
                                        Trabajo #@factura.TrabajoId
                                    </div>
                                }
                            </td>
                            <td class="d-none d-sm-table-cell small" style="color:var(--c-text-secondary);">
                                @factura.ClienteNombre
                            </td>
                            <td>
                                <span class="badge @EstadoPagoClass(factura.EstadoPago)">@EstadoPagoLabel(factura.EstadoPago)</span>
                            </td>
                            <td class="text-end small fw-semibold" style="color:var(--c-text);">
                                @factura.Total.ToString("N2") €
                            </td>
                            <td class="d-none d-sm-table-cell small" style="color:var(--c-text-muted);">
                                @factura.FechaEmision.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1 justify-content-end">
                                    <a asp-action="Detalle" asp-route-id="@factura.Id"
                                       class="btn btn-secondary btn-sm" title="Ver detalle">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                            <circle cx="12" cy="12" r="3"/>
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination")
</div>
