@model Talleres360.Dtos.Facturacion.FacturaDto
@using Talleres360.Dtos.Facturacion
@{
    ViewData["Title"] = $"Factura {Model.NumeroFactura}";
    List<LineaFacturaDto> lineas = Model.Lineas ?? new List<LineaFacturaDto>();

    string EstadoPagoClass(string? estado)
    {
        string estadoNormalizado = estado?.Trim().ToUpperInvariant() ?? string.Empty;
        return estadoNormalizado switch
        {
            "PAGADO" => "badge-pagado",
            "PARCIAL" => "badge-parcial",
            "PENDIENTE" => "badge-pendiente",
            "ANULADO" => "badge-inactivo",
            _ => "badge-inactivo"
        };
    }

    string EstadoPagoLabel(string? estado)
    {
        string estadoNormalizado = estado?.Trim().ToUpperInvariant() ?? string.Empty;
        return estadoNormalizado switch
        {
            "PAGADO" => "Pagado",
            "PARCIAL" => "Parcial",
            "PENDIENTE" => "Pendiente",
            "ANULADO" => "Anulado",
            _ => string.IsNullOrWhiteSpace(estado) ? "Sin estado" : estado
        };
    }
}

<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="link-muted-360">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
        </a>
        <div>
            <h1 class="page-title">Factura @Model.NumeroFactura</h1>
            <p class="page-subtitle">Emitida el @Model.FechaEmision.ToString("dd/MM/yyyy")</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (!string.IsNullOrWhiteSpace(Model.UrlPdf))
        {
            <a href="@Model.UrlPdf" class="btn btn-primary btn-md" target="_blank" rel="noopener noreferrer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                Descargar PDF
            </a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card" style="padding:16px;">
            <div class="small" style="color:var(--c-text-muted);">Estado pago</div>
            <div class="mt-1"><span class="badge @EstadoPagoClass(Model.EstadoPago)">@EstadoPagoLabel(Model.EstadoPago)</span></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card" style="padding:16px;">
            <div class="small" style="color:var(--c-text-muted);">Subtotal</div>
            <div class="fw-semibold mt-1" style="color:var(--c-text);font-size:18px;">@Model.Subtotal.ToString("N2") €</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card" style="padding:16px;">
            <div class="small" style="color:var(--c-text-muted);">IVA</div>
            <div class="fw-semibold mt-1" style="color:var(--c-text);font-size:18px;">@Model.ImporteImpuestos.ToString("N2") €</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card" style="padding:16px;">
            <div class="small" style="color:var(--c-text-muted);">Total</div>
            <div class="fw-semibold mt-1" style="color:var(--c-text);font-size:18px;">@Model.Total.ToString("N2") €</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <div class="card mb-4" style="padding:16px 20px;">
            <div class="small fw-semibold mb-3" style="color:var(--c-text-muted);text-transform:uppercase;letter-spacing:.05em;">Datos del cliente</div>
            <div class="row g-2">
                <div class="col-12">
                    <div class="small" style="color:var(--c-text-muted);">Cliente</div>
                    <div class="small fw-semibold">@Model.ClienteNombre</div>
                </div>
                <div class="col-6">
                    <div class="small" style="color:var(--c-text-muted);">NIF/CIF</div>
                    <div class="small fw-semibold">@Model.ClienteNifCif</div>
                </div>
                <div class="col-6">
                    <div class="small" style="color:var(--c-text-muted);">Email</div>
                    <div class="small fw-semibold">@(string.IsNullOrWhiteSpace(Model.ClienteEmail) ? "—" : Model.ClienteEmail)</div>
                </div>
                <div class="col-6">
                    <div class="small" style="color:var(--c-text-muted);">Teléfono</div>
                    <div class="small fw-semibold">@(string.IsNullOrWhiteSpace(Model.ClienteTelefono) ? "—" : Model.ClienteTelefono)</div>
                </div>
                <div class="col-6">
                    <div class="small" style="color:var(--c-text-muted);">Trabajo</div>
                    @if (Model.TrabajoId.HasValue)
                    {
                        <a class="small fw-semibold" asp-controller="Trabajos" asp-action="Detalle" asp-route-id="@Model.TrabajoId">#@Model.TrabajoId</a>
                    }
                    else
                    {
                        <span class="small fw-semibold">—</span>
                    }
                </div>
                <div class="col-12">
                    <div class="small" style="color:var(--c-text-muted);">Método de pago</div>
                    <div class="small fw-semibold">@(string.IsNullOrWhiteSpace(Model.MetodoPago) ? "—" : Model.MetodoPago)</div>
                </div>
            </div>
        </div>

        <div class="table-card">
            <div class="table-toolbar">
                <span class="fw-semibold" style="color:var(--c-text);">Líneas facturadas</span>
                <span class="small" style="color:var(--c-text-muted);">@lineas.Count línea@(lineas.Count != 1 ? "s" : "")</span>
            </div>
            <div class="table-wrap">
                <table class="t360">
                    <thead>
                        <tr>
                            <th>Concepto</th>
                            <th class="text-end" style="width:60px;">Cant.</th>
                            <th class="text-end d-none d-sm-table-cell" style="width:90px;">P. Unit.</th>
                            <th class="text-end d-none d-sm-table-cell" style="width:80px;">Dto %</th>
                            <th class="text-end d-none d-sm-table-cell" style="width:80px;">IVA %</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!lineas.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4" style="color:var(--c-text-muted);">
                                    <p class="small">No hay líneas registradas en esta factura.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (LineaFacturaDto linea in lineas)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold small" style="color:var(--c-text);">@linea.Concepto</div>
                                    </td>
                                    <td class="text-end small">@linea.Cantidad.ToString("0.##")</td>
                                    <td class="text-end small d-none d-sm-table-cell">@linea.PrecioUnitario.ToString("N2") €</td>
                                    <td class="text-end small d-none d-sm-table-cell">@(linea.DescuentoPorcentaje > 0 ? linea.DescuentoPorcentaje.ToString("0.##") + "%" : "—")</td>
                                    <td class="text-end small d-none d-sm-table-cell">@linea.ImpuestoPorcentaje.ToString("0.##")%</td>
                                    <td class="text-end small fw-semibold">@linea.TotalLinea.ToString("N2") €</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
