@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Resumen de actividad del taller</p>
    </div>
    <button class="btn btn-primary btn-md" type="button">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Nueva orden
    </button>
</div>

<div class="grid-4" style="margin-bottom:20px;">

    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-label">Órdenes abiertas</span>
            <div class="stat-icon" style="background:var(--c-accent-soft);color:var(--c-accent);">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                </svg>
            </div>
        </div>
        <div class="stat-value">—</div>
        <div class="stat-delta"><span>Esta semana</span></div>
    </div>

    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-label">Citas hoy</span>
            <div class="stat-icon" style="background:var(--c-blue-soft);color:var(--c-blue);">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
            </div>
        </div>
        <div class="stat-value">—</div>
        <div class="stat-delta"><span>Pendientes de confirmar</span></div>
    </div>

    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-label">Clientes</span>
            <div class="stat-icon" style="background:var(--c-green-soft);color:var(--c-green);">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
                </svg>
            </div>
        </div>
        <div class="stat-value">—</div>
        <div class="stat-delta"><span>Total registrados</span></div>
    </div>

    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-label">Pendiente de cobro</span>
            <div class="stat-icon" style="background:var(--c-yellow-soft);color:var(--c-yellow-text);">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"/>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
            </div>
        </div>
        <div class="stat-value">—</div>
        <div class="stat-delta"><span>Sin cobrar</span></div>
    </div>

</div>

<div class="grid-2">

    <div class="card">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
            <h2 style="font-family:var(--font-display);font-size:14px;font-weight:700;color:var(--c-text);margin:0;">
                Últimas órdenes
            </h2>
            <a asp-controller="Trabajos" asp-action="Index"
               style="font-size:12px;font-weight:600;color:var(--c-accent);">
                Ver todas →
            </a>
        </div>
        <p style="font-size:13px;color:var(--c-text-muted);text-align:center;padding:24px 0;">
            Las órdenes recientes aparecerán aquí
        </p>
    </div>

    <div class="card">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
            <h2 style="font-family:var(--font-display);font-size:14px;font-weight:700;color:var(--c-text);margin:0;">
                Próximas citas
            </h2>
            <a asp-controller="Citas" asp-action="Index"
               style="font-size:12px;font-weight:600;color:var(--c-accent);">
                Ver todas →
            </a>
        </div>
        <p style="font-size:13px;color:var(--c-text-muted);text-align:center;padding:24px 0;">
            Las citas próximas aparecerán aquí
        </p>
    </div>

</div>
