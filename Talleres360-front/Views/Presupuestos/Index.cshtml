@model Talleres360.Dtos.PagedResponse<Talleres360.Dtos.Trabajos.TrabajoDto>
@using Talleres360.Enums
@{
    ViewData["Title"] = "Presupuestos";

    string EstadoClass(TrabajoEstado e) => e switch {
        TrabajoEstado.PRESUPUESTO         => "badge-pendiente",
        TrabajoEstado.PRESUPUESTO_ENVIADO => "badge-en-curso",
        TrabajoEstado.RECHAZADO           => "badge-inactivo",
        TrabajoEstado.CADUCADO            => "badge-inactivo",
        _                                 => "badge-inactivo"
    };

    string EstadoLabel(TrabajoEstado e) => e switch {
        TrabajoEstado.PRESUPUESTO         => "Borrador",
        TrabajoEstado.PRESUPUESTO_ENVIADO => "Enviado",
        TrabajoEstado.RECHAZADO           => "Rechazado",
        TrabajoEstado.CADUCADO            => "Caducado",
        _                                 => e.ToString()
    };
}

<div class="page-header">
    <div>
        <h1 class="page-title">Presupuestos</h1>
        <p class="page-subtitle">Valoraciones de coste pendientes de aprobación</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary btn-md">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Nuevo presupuesto
    </a>
</div>

<div class="table-card">
    <div class="table-toolbar">
        <span class="small" style="color:var(--c-text-muted);">
            @(ViewData["TotalCount"]) presupuesto@((int)(ViewData["TotalCount"] ?? 0) != 1 ? "s" : "") en total
        </span>
    </div>

    <div class="table-wrap">
        <table class="t360">
            <thead>
                <tr>
                    <th>Nº / Título</th>
                    <th class="d-none d-sm-table-cell">Vehículo</th>
                    <th>Estado</th>
                    <th class="text-end">Total</th>
                    <th class="d-none d-sm-table-cell">Fecha</th>
                    <th style="width:80px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Data.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5" style="color:var(--c-text-muted);">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="d-block mx-auto mb-3" style="opacity:0.4;">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                            <p class="small">No hay presupuestos registrados.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var p in Model.Data)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold small" style="color:var(--c-text);">
                                    @(p.NumeroDocumento ?? $"#{p.Id}")
                                </div>
                                @if (!string.IsNullOrEmpty(p.TituloMantenimiento))
                                {
                                    <div class="small" style="color:var(--c-text-muted);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                        @p.TituloMantenimiento
                                    </div>
                                }
                            </td>
                            <td class="d-none d-sm-table-cell small" style="color:var(--c-text-secondary);">
                                @if (p.VehiculoId.HasValue)
                                {
                                    <span>Veh. #@p.VehiculoId</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td><span class="badge @EstadoClass(p.Estado)">@EstadoLabel(p.Estado)</span></td>
                            <td class="text-end small fw-semibold" style="color:var(--c-text);">
                                @p.Total.ToString("N2") €
                            </td>
                            <td class="d-none d-sm-table-cell small" style="color:var(--c-text-muted);">
                                @p.FechaCreacion.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1 justify-content-end">
                                    <a asp-action="Detalle" asp-route-id="@p.Id"
                                       class="btn btn-secondary btn-sm" title="Ver detalle">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                            <circle cx="12" cy="12" r="3"/>
                                        </svg>
                                    </a>
                                    @if (p.Estado == TrabajoEstado.PRESUPUESTO)
                                    {
                                        <a asp-action="Editar" asp-route-id="@p.Id"
                                           class="btn btn-secondary btn-sm" title="Editar">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                        </a>
                                        <form asp-action="Eliminar" asp-route-id="@p.Id" method="post"
                                              data-confirm-title="Eliminar presupuesto"
                                              data-confirm-msg="Esta acción no se puede deshacer.">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm" title="Eliminar">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"/>
                                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                </svg>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination")
</div>
