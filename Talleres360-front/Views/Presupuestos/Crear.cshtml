@model Talleres360_front.Models.Presupuestos.PresupuestoFormModel
@{
    ViewData["Title"] = "Nuevo Presupuesto";
}

<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="link-muted-360">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
        </a>
        <div>
            <h1 class="page-title">Nuevo presupuesto</h1>
            <p class="page-subtitle">Crear valoración para cliente</p>
        </div>
    </div>
</div>

<div class="w-100" style="max-width:700px;">
    <div class="card">
        @if (!Html.ViewData.ModelState.IsValid && Html.ViewData.ModelState.ContainsKey(string.Empty))
        {
            <div class="mb-4 p-3 rounded-3 border" style="background:var(--c-red-soft);color:var(--c-red);border-color:rgba(12,18,30,0.15);">
                @Html.ValidationSummary(true)
            </div>
        }

        <form asp-action="Crear" method="post" asp-antiforgery="true">
            <div class="row g-3">
                <div class="form-group col-12">
                    <label asp-for="VehiculoId" class="form-label">Vehículo <span style="color:var(--c-red);">*</span></label>
                    <select asp-for="VehiculoId" asp-items="ViewBag.Vehiculos" class="form-select">
                        <option value="">— Buscar vehículo —</option>
                    </select>
                    <span asp-validation-for="VehiculoId" class="form-error"></span>
                </div>

                <div class="form-group col-12 col-md-8">
                    <label asp-for="TituloMantenimiento" class="form-label">Título del presupuesto</label>
                    <input asp-for="TituloMantenimiento" class="form-input" placeholder="Ej: Revisión general y cambio de distribución" />
                    <span asp-validation-for="TituloMantenimiento" class="form-error"></span>
                </div>

                <div class="form-group col-12 col-md-4">
                    <label asp-for="KmEntrada" class="form-label">Kilómetros</label>
                    <input asp-for="KmEntrada" type="number" min="0" class="form-input" />
                    <span asp-validation-for="KmEntrada" class="form-error"></span>
                </div>

                <div class="form-group col-12">
                    <label asp-for="TrabajoRealizado" class="form-label">Detalles u observaciones</label>
                    <textarea asp-for="TrabajoRealizado" class="form-input" rows="4" placeholder="Observaciones adicionales para el presupuesto..."></textarea>
                    <span asp-validation-for="TrabajoRealizado" class="form-error"></span>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-end gap-3 mt-4 pt-4 border-top" style="border-color:var(--c-border);">
                <a asp-action="Index" class="btn btn-secondary btn-md">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-md">Guardar borrador</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
