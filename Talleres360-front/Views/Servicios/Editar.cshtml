@model Talleres360_front.Models.Servicios.ServicioFormModel
@{
    ViewData["Title"] = "Editar Servicio";
}

<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="link-muted-360">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
        </a>
        <div>
            <h1 class="page-title">Editar servicio</h1>
            <p class="page-subtitle">Modificar datos de la tarifa</p>
        </div>
    </div>
</div>

<div class="w-100" style="max-width:600px;">
    <div class="card">
        @if (!Html.ViewData.ModelState.IsValid && Html.ViewData.ModelState.ContainsKey(string.Empty))
        {
            <div class="mb-4 p-3 rounded-3 border" style="background:var(--c-red-soft);color:var(--c-red);border-color:rgba(12,18,30,0.15);">
                @Html.ValidationSummary(true)
            </div>
        }

        <form asp-action="Editar" asp-route-id="@Model.Id" method="post" asp-antiforgery="true">
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="form-group col-12">
                    <label asp-for="Nombre" class="form-label">Nombre del servicio <span style="color:var(--c-red);">*</span></label>
                    <input asp-for="Nombre" class="form-input" />
                    <span asp-validation-for="Nombre" class="form-error"></span>
                </div>

                <div class="form-group col-12">
                    <label asp-for="Descripcion" class="form-label">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-input" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="form-error"></span>
                </div>

                <div class="form-group col-6">
                    <label asp-for="PrecioBase" class="form-label">Precio Base (€) <span style="color:var(--c-red);">*</span></label>
                    <input asp-for="PrecioBase" type="number" step="0.01" min="0" class="form-input" />
                    <span asp-validation-for="PrecioBase" class="form-error"></span>
                </div>

                <div class="form-group col-6">
                    <label asp-for="ImpuestoPorcentaje" class="form-label">IVA (%) <span style="color:var(--c-red);">*</span></label>
                    <input asp-for="ImpuestoPorcentaje" type="number" step="0.01" min="0" max="100" class="form-input" />
                    <span asp-validation-for="ImpuestoPorcentaje" class="form-error"></span>
                </div>

                <div class="form-group col-12 mt-3">
                    <label class="d-flex align-items-center gap-2 cursor-pointer">
                        <input asp-for="Activo" type="checkbox" />
                        <span class="fw-semibold" style="color:var(--c-text);">Servicio Activo</span>
                    </label>
                    <span class="d-block small mt-1" style="color:var(--c-text-muted);margin-left:24px;">Si está inactivo, no aparecerá para agregarse a nuevos trabajos.</span>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-end gap-3 mt-4 pt-4 border-top" style="border-color:var(--c-border);">
                <a asp-action="Index" class="btn btn-secondary btn-md">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-md">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
