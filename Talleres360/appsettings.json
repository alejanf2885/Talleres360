{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlSaas": "${DB_CONNECTION_SAAS}",
    "SqlBBDD": "${DB_CONNECTION_PROD}",
    "AzureStorage": "${AZURE_STORAGE_CONNECTION_STRING}"
  },
  "Jwt": {
    "Key": "${JWT_KEY}",
    "Issuer": "Talleres360API",
    "Audience": "Talleres360Users"
  },
  "NotificationsApi": {
    "BaseUrl": "${NOTIFICATIONS_API_URL}",
    "ApiKey": "${NOTIFICATIONS_API_KEY}"
  },
  "AppSettings": {
    "FrontendUrl": "https://talleres360.dpdns.org/"
  },
  "Stripe": {
    "Enabled": false
  }
}